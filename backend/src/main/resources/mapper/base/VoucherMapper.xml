<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huicai.base.voucher.mapper.VoucherMapper">

    <resultMap id="VoucherDetailMap" type="com.huicai.base.voucher.entity.VoucherEntity">
        <id column="id" property="id"/>
        <result column="voucher_no" property="voucherNo"/>
        <result column="period" property="period"/>
        <result column="voucher_type_id" property="voucherTypeId"/>
        <result column="status" property="status"/>
        <result column="total_debit" property="totalDebit"/>
        <result column="total_credit" property="totalCredit"/>
        <result column="summary" property="summary"/>
        <result column="source" property="source"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="submitted_by" property="submittedBy"/>
        <result column="submitted_at" property="submittedAt"/>
        <result column="audited_by" property="auditedBy"/>
        <result column="audited_at" property="auditedAt"/>
        <result column="posted_by" property="postedBy"/>
        <result column="posted_at" property="postedAt"/>
        <result column="reversed_from" property="reversedFrom"/>
    </resultMap>

    <select id="selectVoucherPage" resultMap="VoucherDetailMap">
        SELECT v.*
        FROM t_voucher v
        WHERE v.deleted = 0
        <if test="period != null and period != ''">
            AND v.period = #{period}
        </if>
        <if test="status != null and status != ''">
            AND v.status = #{status}
        </if>
        <if test="voucherTypeId != null">
            AND v.voucher_type_id = #{voucherTypeId}
        </if>
        <if test="keyword != null and keyword != ''">
            AND (v.voucher_no LIKE CONCAT('%', #{keyword}, '%')
            OR v.summary LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test="voucherNo != null and voucherNo != ''">
            AND v.voucher_no = #{voucherNo}
        </if>
        <if test="sourceDocNo != null and sourceDocNo != ''">
            AND v.source_doc_no LIKE CONCAT('%', #{sourceDocNo}, '%')
        </if>
        ORDER BY v.period DESC, v.voucher_no DESC
    </select>

    <select id="selectVoucherList" resultMap="VoucherDetailMap">
        SELECT v.*
        FROM t_voucher v
        WHERE v.deleted = 0
        <if test="period != null and period != ''">
            AND v.period = #{period}
        </if>
        <if test="status != null and status != ''">
            AND v.status = #{status}
        </if>
        <if test="voucherTypeId != null">
            AND v.voucher_type_id = #{voucherTypeId}
        </if>
        <if test="keyword != null and keyword != ''">
            AND (v.voucher_no LIKE CONCAT('%', #{keyword}, '%')
            OR v.summary LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test="voucherNo != null and voucherNo != ''">
            AND v.voucher_no = #{voucherNo}
        </if>
        <if test="sourceDocNo != null and sourceDocNo != ''">
            AND v.source_doc_no LIKE CONCAT('%', #{sourceDocNo}, '%')
        </if>
        ORDER BY v.period DESC, v.voucher_no DESC
    </select>

    <select id="selectVoucherDetail" resultMap="VoucherDetailMap">
        SELECT v.*
        FROM t_voucher v
        WHERE v.id = #{id} AND v.deleted = 0
    </select>

    <select id="selectMaxVoucherNo" resultType="java.lang.String">
        SELECT MAX(v.voucher_no)
        FROM t_voucher v
        WHERE v.period = #{period}
        AND v.voucher_type_id = #{voucherTypeId}
        AND v.deleted = 0
    </select>

    <update id="batchUpdateStatus">
        UPDATE t_voucher
        SET status = #{status},
            version = version + 1,
            <choose>
                <when test="status == 'SUBMITTED'">
                    submitted_by = #{userId}, submitted_at = CURRENT_TIMESTAMP
                </when>
                <when test="status == 'AUDITED'">
                    audited_by = #{userId}, audited_at = CURRENT_TIMESTAMP
                </when>
                <when test="status == 'POSTED'">
                    posted_by = #{userId}, posted_at = CURRENT_TIMESTAMP
                </when>
                <otherwise>
                    updated_by = #{userId}, updated_at = CURRENT_TIMESTAMP
                </otherwise>
            </choose>
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND deleted = 0
        <if test="version != null">
            AND version = #{version}
        </if>
    </update>

</mapper>
