package com.huicai.module.system.service.impl;

import com.huicai.module.system.entity.UserEntity;
import com.huicai.module.system.mapper.DeptMapper;
import com.huicai.module.system.mapper.UserMapper;
import com.huicai.module.system.mapper.UserRoleMapper;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class UserServiceImplTest {

    @Mock private UserMapper userMapper;
    @Mock private DeptMapper deptMapper;
    @Mock private UserRoleMapper userRoleMapper;
    @InjectMocks private UserServiceImpl service;

    private UserEntity stubEntity() {
        UserEntity e = new UserEntity();
        e.setId(1L);
        e.setUsername("admin");
        e.setRealName("管理员");
        e.setStatus("ACTIVE");
        e.setDeptId(1L);
        return e;
    }

    @Test
    void getById_存在_返回Entity() {
        when(userMapper.selectById(1L)).thenReturn(stubEntity());
        UserEntity result = service.getById(1L);
        assertNotNull(result);
    }

    @Test
    void getByUsername_存在_返回Entity() {
        when(userMapper.selectOne(any())).thenReturn(stubEntity());
        UserEntity result = service.getByUsername("admin");
        assertNotNull(result);
    }

    @Test
    void pageUser_调selectPage() {
        when(userMapper.selectPage(any(), any())).thenReturn(null);
        service.pageUser(1, 20, null, null, null);
        verify(userMapper).selectPage(any(), any());
    }

    @Test
    void updateStatus_调updateById() {
        when(userMapper.selectById(1L)).thenReturn(stubEntity());
        service.updateStatus(1L, "DISABLED");
        verify(userMapper).updateById(any(UserEntity.class));
    }

    @Test
    void resetPassword_调updateById() {
        when(userMapper.selectById(1L)).thenReturn(stubEntity());
        service.resetPassword(1L, "newpass123");
        verify(userMapper).updateById(any(UserEntity.class));
    }
}