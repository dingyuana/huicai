package com.huicai.module.system.service.impl;

import com.huicai.module.system.entity.RoleEntity;
import com.huicai.module.system.mapper.RoleMapper;
import com.huicai.module.system.mapper.RoleMenuMapper;
import com.huicai.module.system.mapper.UserRoleMapper;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class RoleServiceImplTest {

    @Mock private RoleMapper roleMapper;
    @Mock private RoleMenuMapper roleMenuMapper;
    @Mock private UserRoleMapper userRoleMapper;
    @InjectMocks private RoleServiceImpl service;

    private RoleEntity stubEntity() {
        RoleEntity e = new RoleEntity();
        e.setId(1L);
        e.setName("测试角色");
        e.setCode("ROLE-001");
        e.setStatus("ACTIVE");
        return e;
    }

    @Test
    void getById_存在_返回Entity() {
        when(roleMapper.selectById(1L)).thenReturn(stubEntity());
        RoleEntity result = service.getById(1L);
        assertNotNull(result);
    }

    @Test
    void getById_不存在_返回Null() {
        when(roleMapper.selectById(99L)).thenReturn(null);
        assertNull(service.getById(99L));
    }

    @Test
    void create_正常_调insert() {
        service.create(stubEntity());
        verify(roleMapper).insert(any(RoleEntity.class));
    }

    @Test
    void update_正常_调updateById() {
        service.update(stubEntity());
        verify(roleMapper).updateById(any(RoleEntity.class));
    }

    @Test
    void pageRole_调selectPage() {
        when(roleMapper.selectPage(any(), any())).thenReturn(null);
        service.pageRole(1, 20, null, null);
        verify(roleMapper).selectPage(any(), any());
    }

    @Test
    void listAll_调selectList() {
        when(roleMapper.selectList(any())).thenReturn(java.util.Collections.singletonList(stubEntity()));
        service.listAll();
        verify(roleMapper).selectList(any());
    }
}