    @Test
    @DisplayName("CustomerMapper insert 方法应接受正确参数")
    void insert_shouldAcceptValidParams() {
        CustomerMapper mapper = Mockito.mock(CustomerMapper.class);
        CustomerEntity entity = new CustomerEntity();
        
        // 设置必要字段
        entity.setCode("CUST001");
        entity.setName("测试客户");
        entity.setContactPerson("张三");
        entity.setPhone("13800000001");
        entity.setEmail("cust@example.com");
        entity.setAddress("测试地址");
        entity.setTaxNo("91110000MA001");
        entity.setBankName("工商银行");
        entity.setBankAccount("6222000012345678");
        entity.setCreditLimit(java.math.BigDecimal.valueOf(100000));
        entity.setCreditDays(30);
        entity.setSubjectId(1L);
        entity.setIsActive(true);
        entity.setRemark("测试客户");
        
        // 验证方法可调用且返回正确类型
        Mockito.when(mapper.insert(entity)).thenReturn(1);
        int rows = mapper.insert(entity);
        
        assertEquals(1, rows);
        Mockito.verify(mapper).insert(entity);
    }

