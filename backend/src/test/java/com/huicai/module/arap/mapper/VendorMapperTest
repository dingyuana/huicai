    @Test
    @DisplayName("VendorMapper insert 方法应接受正确参数")
    void insert_shouldAcceptValidParams() {
        VendorMapper mapper = Mockito.mock(VendorMapper.class);
        VendorEntity entity = new VendorEntity();
        
        // 设置必要字段
        entity.setCode("VEND001");
        entity.setName("测试供应商");
        entity.setContactPerson("李四");
        entity.setPhone("13800000003");
        entity.setEmail("vend@example.com");
        entity.setAddress("测试地址");
        entity.setTaxNo("91110000MA002");
        entity.setBankName("建设银行");
        entity.setBankAccount("6227000012345678");
        entity.setCreditLimit(java.math.BigDecimal.valueOf(50000));
        entity.setCreditDays(60);
        entity.setSubjectId(2L);
        entity.setIsActive(true);
        entity.setRemark("测试供应商");
        
        // 验证方法可调用且返回正确类型
        Mockito.when(mapper.insert(entity)).thenReturn(1);
        int rows = mapper.insert(entity);
        
        assertEquals(1, rows);
        Mockito.verify(mapper).insert(entity);
    }

