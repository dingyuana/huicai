    @Test
    @DisplayName("ArapSettlementMapper insert 方法应接受正确参数")
    void insert_shouldAcceptValidParams() {
        ArapSettlementMapper mapper = Mockito.mock(ArapSettlementMapper.class);
        ArapSettlementEntity entity = new ArapSettlementEntity();
        
        // 设置必要字段
        entity.setSettlementNo("SETTLE-001");
        entity.setSettlementType("RECEIPT");
        entity.setSettlementDate(java.time.LocalDate.now());
        entity.setPeriod("202607");
        entity.setPartyId(1L);
        entity.setPartyType("CUSTOMER");
        entity.setTotalAmount(java.math.BigDecimal.valueOf(10000));
        entity.setDiscountAmount(java.math.BigDecimal.ZERO);
        entity.setVoucherId(null);
        entity.setVoucherNo(null);
        entity.setStatus("DRAFT");
        entity.setCreatedBy(1L);
        entity.setUpdatedBy(1L);
        
        // 验证方法可调用且返回正确类型
        Mockito.when(mapper.insert(entity)).thenReturn(1);
        int rows = mapper.insert(entity);
        
        assertEquals(1, rows);
        Mockito.verify(mapper).insert(entity);
    }

