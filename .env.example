# ============================================================
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实口令。
#
# 用法：docker compose 会自动读取同目录 .env；
#       本地直接跑后端时用：set -a && . ./.env && set +a && cd backend && mvn spring-boot:run
# ============================================================

# ---- JWT 签名密钥（必填，无默认值，缺失则启动失败）----
# 生成：openssl rand -base64 48
# 长度要求 ≥32 字节（HMAC-SHA256），否则 JwtProvider 抛 WeakKeyException
JWT_SECRET=change-me-openssl-rand-base64-48

# ---- PostgreSQL ----
POSTGRES_USER=huicai
POSTGRES_PASSWORD=huicai123
POSTGRES_DB=huicai

# ---- MinIO ----
MINIO_ROOT_USER=huicai
MINIO_ROOT_PASSWORD=huicai123

# ---- RabbitMQ ----
RABBITMQ_USER=huicai
RABBITMQ_PASSWORD=huicai123

# ---- AI 服务（可选，本轮商用化修复已排除 AI 功能）----
# NVIDIA_API_KEY=
# AMD_RADEON_API_KEY=
