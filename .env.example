# ============================================================
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实口令。
#
# 用法：docker compose 会自动读取同目录 .env；
#       本地直接跑后端时用：set -a && . ./.env && set +a && cd backend && mvn spring-boot:run
# ============================================================

# ---- JWT 签名密钥（必填，无默认值，缺失则启动失败）----
# 生成：openssl rand -base64 48
# 长度要求 ≥32 字节（HMAC-SHA256），否则 JwtProvider 抛 WeakKeyException
JWT_SECRET=change-me-openssl-rand-base64-48

# ---- PostgreSQL ----
# POSTGRES_* 是**容器 bootstrap 超级用户**（首次初始化建库用），仅运维/迁移使用。
POSTGRES_USER=huicai
POSTGRES_PASSWORD=huicai123
POSTGRES_DB=huicai

# ---- 应用数据库账号（非超级用户，P101-M5b/V2）----
# 应用**必须**用非超级用户连接：超级用户会绕过 RLS（70 张租户表的行级安全策略
# 对超级用户无效，实测三种 app.enterprise_id 取值返回同样的行数）。
# 该角色由 docs/development/plans/2026-10-01-M5b-role-downgrade-runbook.md §V2 创建，
# 并已接管全部对象属主（Flyway 的 DDL 需要属主身份）。首次在新环境部署时必须先执行该手册。
DB_USERNAME=huicai_app
DB_PASSWORD=huicai123

# ---- Flyway 迁移账号（2026-10-09 新增，必填）----
# 🔴 为什么必须单独配：应用用 huicai_app（NOSUPERUSER + NOBYPASSRLS），RLS 生效后
#   任何向租户表 seed 的迁移都会被 with_check 拒（72 张表策略的 with_check 为空
#   ⇒ PostgreSQL 复用 qual 当 WITH CHECK ⇒ 要求 enterprise_id = GUC，
#   而迁移路径上没有企业上下文）⇒ 应用启动即失败。
# 默认值与 POSTGRES_* 相同：M5b 手册既定设计就是「huicai 超级用户保留给运维/迁移」。
# ⚠️ 若你的环境把该口令改成了强口令，这里必须同步改，否则 Flyway 连不上（启动失败）。
FLYWAY_USER=huicai
FLYWAY_PASSWORD=huicai123

# ---- MinIO ----
MINIO_ROOT_USER=huicai
MINIO_ROOT_PASSWORD=huicai123

# ---- RabbitMQ ----
RABBITMQ_USER=huicai
RABBITMQ_PASSWORD=huicai123

# ---- AI 服务（可选，本轮商用化修复已排除 AI 功能）----
# NVIDIA_API_KEY=
# AMD_RADEON_API_KEY=
